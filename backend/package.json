{
  "name": "course-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Node.js + Express + MongoDB backend for the course_selling LMS (auth, uploads, notes, spaces/blocks).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "recount": "node src/scripts/recountStats.js",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-rate-limit": "7.4.1",
    "firebase-admin": "^13.10.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "nanoid": "5.1.16",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "zod": "4.6.7"
  }
}
