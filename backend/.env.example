# Copy to .env for local development. For production (Render / Docker) set the
# same keys as environment variables — see ../README.md "Deploy".
#
# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Note: 5000 is used by macOS AirPlay Receiver, so the default is 5001.
PORT=5001
# Comma-separated list of allowed frontend origins (CORS). Use the Next.js app URL.
CORS_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/course_lms
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>/course_lms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/course_lms

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# httpOnly cookie name holding the JWT
AUTH_COOKIE_NAME=course_token
# Set to "true" in production (HTTPS). Cookie Secure flag.
COOKIE_SECURE=false
# "lax" for local dev (same site). In production the frontend (Vercel) and the
# API (Render) are different domains, so use "none" (requires COOKIE_SECURE=true).
# Defaults: none in production, lax otherwise.
COOKIE_SAME_SITE=lax

# ─── Admin (owner) account ───────────────────────────────────────────────────
# Created / promoted to ADMIN automatically when the server boots.
OWNER_EMAIL=gautam123@gmail.com
OWNER_PASSWORD=change-me-before-first-boot
OWNER_NAME=Gautam
# Outside production the password above is kept in sync on boot (so you can
# never get locked out). Set to false to manage the admin password manually.
OWNER_SYNC_PASSWORD=true

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Where uploaded files are stored on disk (relative to backend root).
UPLOAD_DIR=uploads
# Max upload size in bytes (default 2 GB).
MAX_UPLOAD_BYTES=2147483648

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
\n
# ─── Cloudinary (file storage) ───────────────────────────────────────────────
# When all three are set, PDFs and attachments are stored on Cloudinary as
# private assets and streamed through this API. Leave blank to use local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder (prefix) inside your Cloudinary media library.
CLOUDINARY_FOLDER=hellos

# Calendar timezone for date-keyed content (Today Code). Default: Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata
